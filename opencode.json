{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "M:/Cyber_Teacher/Cyber_Teacher"],
      "enabled": true,
      "environment": {
        "OS": "windows"
      }
    },
    "cyberteacher-faiss": {
      "type": "local",
      "command": ["python", "-u", "M:/Cyber_Teacher/Cyber_Teacher/mcp_server_faiss.py"],
      "enabled": false,
      "environment": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "cyberteacher-project": {
      "type": "local",
      "command": ["python", "-u", "M:/Cyber_Teacher/Cyber_Teacher/mcp_server.py"],
      "enabled": true,
      "environment": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}