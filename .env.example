# Пример переменных окружения для CyberTeacher

# === БЕЗОПАСНОСТЬ (ОБЯЗАТЕЛЬНО для продакшена) ===
CYBERTEACHER_JWT_SECRET=<generate_with: python -c "import secrets; print(secrets.token_hex(32))">
CYBERTEACHER_ENC_KEY=<generate_with: python -c "import secrets; print(secrets.token_hex(16))">
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# === БАЗА ДАННЫХ ===
# SQLite (по умолчанию):
DATABASE_URL=sqlite:///./memory/chat_history.db

# PostgreSQL (раскомментируй и заполни для перехода на PostgreSQL):
# DATABASE_URL=postgresql://cyberteacher:cyberteacher_pass@localhost:5432/cyber_teacher

DB_PASSWORD=<your_db_password_here>
PGADMIN_PASSWORD=<your_pgadmin_password_here>
DB_ECHO=false

# === LLM ПРОВАЙДЕР ===
# Основной провайдер: ollama | groq | openrouter | huggingface | mock
LLM_PROVIDER=mock
# Fallback цепочка (автоматический переход при ошибках):
# Команда: ollama,groq,openrouter,huggingface,mock — будет использована в этом порядке при сбоях
LLM_PROVIDERS=ollama,groq,openrouter,huggingface,mock
# Таймаут запроса к провайдеру (сек)
PROVIDER_TIMEOUT=30

# === OLLAMA ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
MODEL_TEMPERATURE=0.3

# === GROQ ===
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# === OPENROUTER ===
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === HUGGINGFACE ===
HF_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
HF_API_URL=https://api-inference.huggingface.co/models
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === ПУТИ ===
PERSIST_DIR=./embeddings
DB_FILE=./memory/chat_history.db
KNOWLEDGE_DIR=./knowledge_base
METADATA_FILE=./embeddings/metadata.json
STATE_FILE=./memory/app_state.json
ACHIEVEMENTS_FILE=./data/achievements.json
LOG_FILE=./cyberteacher.log

# === RAG ===
BM25_ENABLED=true
BM25_K=20

# === КЭШИРОВАНИЕ ===
RESPONSE_CACHE_SIZE=100
RESPONSE_CACHE_FILE=./memory/response_cache.json

# === ОПТИМИЗАЦИЯ ===
MAX_WORKERS=8
CHUNK_SIZE=600
CHUNK_OVERLAP=50
MAX_TOKENS=2000

# === ПЕДАГОГИКА ===
SOCRATIC_ENABLED=true
THINKING_ENABLED=true

# === RERANKING ===
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5
